diff --git a/spi.c b/spi.c
index e5facbd..8ee66f6 100644
--- a/spi.c
+++ b/spi.c
@@ -230,6 +230,41 @@ static int morse_spi_setup(struct spi_device *spi, u32 max_speed_hz)
 	return ret;
 }
 
+static uint spi_pre_token_bytes = 4;
+module_param(spi_pre_token_bytes, uint, 0644);
+MODULE_PARM_DESC(spi_pre_token_bytes,
+		 "Bytes to wait for MISO-ready between a write command's R1 and the data token");
+
+static uint spi_tx_rshift;
+module_param(spi_tx_rshift, uint, 0644);
+MODULE_PARM_DESC(spi_tx_rshift,
+		 "Right-shift every transmitted SPI buffer by N bits, to land on a byte grid the chip agrees with");
+
+static uint spi_rx_lshift;
+module_param(spi_rx_lshift, uint, 0644);
+MODULE_PARM_DESC(spi_rx_lshift,
+		 "Left-shift every received SPI buffer by N bits to re-align a chip that responds off a byte boundary");
+
+static uint spi_init_train_bytes = 18;
+module_param(spi_init_train_bytes, uint, 0644);
+MODULE_PARM_DESC(spi_init_train_bytes,
+		 "Training bytes clocked with CS deasserted during init; 0 skips the burst entirely");
+
+static bool spi_init_cs_flip = true;
+module_param(spi_init_cs_flip, bool, 0644);
+MODULE_PARM_DESC(spi_init_cs_flip,
+		 "Flip SPI_CS_HIGH around the init training burst so it goes out with CS deasserted");
+
+static bool spi_ack_scan = true;
+module_param(spi_ack_scan, bool, 0644);
+MODULE_PARM_DESC(spi_ack_scan,
+		 "Scan the ack window for an accept token instead of stopping at the first non-0xff byte");
+
+static bool spi_init_no_cs = true;
+module_param(spi_init_no_cs, bool, 0644);
+MODULE_PARM_DESC(spi_init_no_cs,
+		 "Use SPI_NO_CS for the init training burst so it really goes out with CS deasserted");
+
 /* Hack to shift bits for problematic SPI controllers */
 static void morse_shift_buffer(u8 *data, unsigned int len, u8 right_shift_bits)
 {
@@ -248,6 +283,30 @@ static void morse_shift_buffer(u8 *data, unsigned int len, u8 right_shift_bits)
 	}
 }
 
+/*
+ * Compensate a chip that starts its response a fixed number of bit times after
+ * the command instead of on the next byte boundary. The MM6108 on the Wio-WM6108
+ * answers 2 bits late and consistently: with CS/clock/CRC all verified good (a
+ * deliberately corrupted CMD0 CRC comes back as R1=0x09, CMD13 as R1=0x05), the
+ * only thing wrong with the received stream is its byte framing. is_rk3288 above
+ * fixes the opposite skew, so it shifts the other way.
+ */
+static void morse_lshift_buffer(u8 *data, unsigned int len, u8 left_shift_bits)
+{
+	unsigned int ii;
+
+	left_shift_bits = min_t(u8, left_shift_bits, 7);
+	if (!left_shift_bits)
+		return;
+
+	for (ii = 0; ii < len; ii++) {
+		u8 next = (ii + 1 < len) ? data[ii + 1] : 0xFF;
+
+		data[ii] = (data[ii] << left_shift_bits) |
+			   (next >> (8 - left_shift_bits));
+	}
+}
+
 static int morse_spi_xfer(struct morse_spi *mspi, unsigned int len)
 {
 	int ret = 0;
@@ -261,11 +320,18 @@ static int morse_spi_xfer(struct morse_spi *mspi, unsigned int len)
 	}
 
 	mspi->t.len = len;
+
+	if (spi_tx_rshift)
+		morse_shift_buffer(mspi->data, len, spi_tx_rshift);
+
 	ret = spi_sync_locked(mspi->spi, &mspi->m);
 
 	if (is_rk3288)
 		morse_shift_buffer(mspi->data, len, 1);
 
+	if (spi_rx_lshift)
+		morse_lshift_buffer(mspi->data, len, spi_rx_lshift);
+
 	return ret;
 }
 
@@ -288,20 +354,123 @@ static void morse_spi_initsequence(struct morse_spi *mspi)
 {
 	struct spi_device *spi = mspi->spi;
 
-	spi->mode |= SPI_CS_HIGH;
+	/*
+	 * The training clocks must go out with CS *deasserted*, which this
+	 * function achieves by flipping SPI_CS_HIGH and putting it back.
+	 *
+	 * Which way to flip depends on the kernel. On a vendor kernel carrying
+	 * SPI_CONTROLLER_ENABLE_CS_GPIOD, SPI_CS_HIGH starts clear and setting
+	 * it deasserts CS. On mainline (checked on 6.18), spi_add_device()
+	 * forces SPI_CS_HIGH on for any cs-gpios target so that gpiolib applies
+	 * the active-low inversion exactly once - there SPI_CS_HIGH set is the
+	 * normal, CS-active-low state, and *clearing* it is what deasserts CS.
+	 *
+	 * Blindly setting-then-clearing (the original code) therefore leaves a
+	 * mainline GPIO-CS bus with inverted chip select: CS is driven high for
+	 * every transfer afterwards, the chip is never selected, and probe dies
+	 * at CMD63 with -EPROTO. So flip whichever way is away from the state
+	 * the core handed us, and restore that state afterwards.
+	 */
+	const bool cs_high_default = !!(spi->mode & SPI_CS_HIGH);
+	uint train = min_t(uint, spi_init_train_bytes, MM610X_BUF_SIZE);
+
+	/*
+	 * This burst is the prime suspect for the constant 2-bit skew on the
+	 * chip's responses: if the CS polarity flip below goes the wrong way for
+	 * this kernel, the chip sees these training clocks *selected* and starts
+	 * counting bits before we think it does. spi_init_train_bytes and
+	 * spi_init_cs_flip exist to test exactly that - if the skew tracks the
+	 * training byte count, or disappears with the burst suppressed, it is
+	 * self-inflicted here rather than a property of the bus.
+	 */
+	dev_info(&spi->dev, "init: mode=0x%x cs_high_default=%d train=%u flip=%d\n",
+		 spi->mode, cs_high_default, train, spi_init_cs_flip);
+
+	/*
+	 * The chip needs ~74 clocks with CS *deasserted* to enter SPI mode --
+	 * Morse state this explicitly in their i.MX93 porting thread, and note
+	 * that a chip select left asserted during init stops the device
+	 * responding to subsequent commands.
+	 *
+	 * Flipping SPI_CS_HIGH does not achieve that on a cs-gpios controller.
+	 * spi_setup() forces SPI_CS_HIGH back on, measured here: spi->mode reads
+	 * 0x4 before the flip, after the flip, and after the restore. The burst
+	 * therefore goes out with the chip *selected*, the chip never enters SPI
+	 * mode, and every response afterwards sits two bit times off the byte
+	 * grid -- `c0 7f` where `01 ff` is expected.
+	 *
+	 * SPI_NO_CS does achieve it: the controller leaves the chip select line
+	 * alone for the transfer, so the GPIO stays at its inactive level for
+	 * the whole burst. Verified from userspace against the same board: with
+	 * the burst delivered this way the response lands on the byte boundary,
+	 * 6 runs out of 6, and CMD0/CMD13/CMD63 all return correct R1 values.
+	 *
+	 * Order matters. This has to happen after reset and before any other
+	 * transaction; once the chip has been addressed with CS asserted it does
+	 * not recover, and a later burst does not fix it.
+	 */
+	if (spi_init_no_cs && train) {
+		const u32 saved_mode = spi->mode;
+
+		spi->mode |= SPI_NO_CS;
+		if (spi_setup(spi) == 0 && (spi->mode & SPI_NO_CS)) {
+			dev_info(&spi->dev, "init: training with SPI_NO_CS, mode=0x%x\n",
+				 spi->mode);
+			memset(mspi->data, 0xFF, MM610X_BUF_SIZE);
+			morse_spi_xfer(mspi, train);
+
+			spi->mode = saved_mode;
+			if (spi_setup(spi) != 0)
+				dev_err(&spi->dev, "can't restore mode after training\n");
+			else
+				dev_info(&spi->dev, "init: mode restored to 0x%x\n", spi->mode);
+			return;
+		}
+		dev_warn(&spi->dev,
+			 "init: SPI_NO_CS not honoured (mode=0x%x), falling back\n",
+			 spi->mode);
+		spi->mode = saved_mode;
+		spi_setup(spi);
+	}
+
+	if (!spi_init_cs_flip) {
+		if (train) {
+			memset(mspi->data, 0xFF, MM610X_BUF_SIZE);
+			morse_spi_xfer(mspi, train);
+		}
+		dev_info(&spi->dev, "init: CS flip suppressed, mode left at 0x%x\n", spi->mode);
+		return;
+	}
+
+	if (cs_high_default)
+		spi->mode &= ~SPI_CS_HIGH;
+	else
+		spi->mode |= SPI_CS_HIGH;
+
 	if (spi_setup(spi) != 0) {
 		/* Just warn; most cards work without it. */
 		dev_warn(&spi->dev, "can't change chip-select polarity\n");
-		spi->mode &= ~SPI_CS_HIGH;
+		if (cs_high_default)
+			spi->mode |= SPI_CS_HIGH;
+		else
+			spi->mode &= ~SPI_CS_HIGH;
 	} else {
+		dev_info(&spi->dev, "init: CS deasserted for training, mode=0x%x\n", spi->mode);
+
 		/* We will send only 0xFF for training */
 		memset(mspi->data, 0xFF, MM610X_BUF_SIZE);
-		morse_spi_xfer(mspi, 18);
+		if (train)
+			morse_spi_xfer(mspi, train);
 
-		spi->mode &= ~SPI_CS_HIGH;
+		if (cs_high_default)
+			spi->mode |= SPI_CS_HIGH;
+		else
+			spi->mode &= ~SPI_CS_HIGH;
 		if (spi_setup(spi) != 0) {
 			/* Wot, we can't get the same setup we had before? */
 			dev_err(&spi->dev, "can't restore chip-select polarity\n");
+		} else {
+			dev_info(&spi->dev, "init: CS polarity restored, mode=0x%x\n", spi->mode);
 		}
 	}
 }
@@ -348,7 +517,10 @@ static int morse_spi_find_response(struct morse_spi *mspi, u8 *data, u8 *end, u8
 	}
 
 	if (*cp != 0x00) {
-		MORSE_SPI_DBG(mors, "%s: SPI response error\n", __func__);
+		MORSE_SPI_DBG(mors, "%s: SPI response error: got 0x%02x at +%td of %td\n",
+			      __func__, *cp, cp - data, end - data);
+		print_hex_dump(KERN_INFO, "morse rx: ", DUMP_PREFIX_OFFSET, 16, 1,
+			       data, min_t(size_t, (size_t)(end - data), (size_t)32), false);
 		if (resp)
 			*resp = NULL;
 		return -EPROTO;
@@ -480,22 +652,58 @@ exit:
 static u8 *morse_spi_find_data_ack(struct morse_spi *mspi, u8 *data, u8 *end)
 {
 	u8 *cp = data;
+	u8 *dump = data;
+	const ptrdiff_t window = end - data;
 
-	while (cp < end && *cp == 0xff)
-		cp++;
+	/*
+	 * Stock stops at the first byte that is not 0xff and rejects it if it is
+	 * not an accept token. Morse's own OpenWrt feed patch
+	 * (003_fix_spi_inter_transaction_delay / ekh01-spi-fix) scans past
+	 * anything that is not an accept token instead, and this board needs
+	 * that: after the SPI_NO_CS init fix the chip answers, but the first
+	 * non-0xff byte in a multi-block firmware write is 0xeb, not 0x05.
+	 */
+	if (spi_ack_scan) {
+		while (cp < end && SPI_MMC_RESPONSE_CODE(*cp) != SPI_RESPONSE_ACCEPTED)
+			cp++;
+	} else {
+		while (cp < end && *cp == 0xff)
+			cp++;
+	}
 
-	if (cp == end)
+	if (cp == end) {
+		/*
+		 * These two are not the same failure and must not read the same.
+		 * In scan mode reaching the end means no accept token was found,
+		 * which says nothing about whether the chip answered at all.
+		 */
+		MORSE_PR_ERR(FEATURE_ID_SPI, "%s failed: %s in the %td bytes clocked after CRC\n",
+			     __func__,
+			     spi_ack_scan ? "no accept token" : "no non-0xff byte",
+			     window);
 		goto exit;
+	}
 
-	if (SPI_MMC_RESPONSE_CODE(*cp) != SPI_RESPONSE_ACCEPTED)
+	if (SPI_MMC_RESPONSE_CODE(*cp) != SPI_RESPONSE_ACCEPTED) {
+		MORSE_PR_ERR(FEATURE_ID_SPI,
+			     "%s failed: first non-0xff 0x%02x (code 0x%02x) at +%td of %td\n",
+			     __func__, *cp, SPI_MMC_RESPONSE_CODE(*cp), cp - data, window);
+		dump = cp;
 		goto exit;
+	}
 
 	/* point to the next byte */
 	cp++;
 	return cp;
 
 exit:
-	MORSE_PR_ERR(FEATURE_ID_SPI, "%s failed\n", __func__);
+	/*
+	 * Dump from the first interesting byte, not from the start of the window:
+	 * with spi_post_write_status_bytes in the hundreds the head of the window
+	 * is all 0xff and says nothing about where the chip actually answered.
+	 */
+	print_hex_dump(KERN_INFO, "morse ackwin: ", DUMP_PREFIX_OFFSET, 16, 1,
+		       dump, min_t(size_t, (size_t)(end - dump), (size_t)32), false);
 	return NULL;
 }
 
@@ -668,7 +876,7 @@ static int morse_spi_cmd53_write(struct morse_spi *mspi, u8 fn, u32 address, u8
 	cp += 4;
 
 	/* Allow 4 bytes to get 0xFF (i.e MISO ready) */
-	cp += 4;
+	cp += spi_pre_token_bytes;
 
 	data_size = block ? MMC_SPI_BLOCKSIZE : count;
 	for (i = 0; i < (block ? count : 1); i++, data += MMC_SPI_BLOCKSIZE) {
@@ -748,6 +956,8 @@ static int morse_spi_cmd53_write(struct morse_spi *mspi, u8 fn, u32 address, u8
 
 exit:
 	MORSE_PR_ERR(FEATURE_ID_SPI, "%s failed\n", __func__);
+	print_hex_dump(KERN_INFO, "morse w53: ", DUMP_PREFIX_OFFSET, 16, 1,
+		       mspi->data, min_t(size_t, (size_t)(end - mspi->data), (size_t)64), false);
 	return -EPROTO;
 }
 
@@ -1516,7 +1726,14 @@ static int morse_spi_probe(struct spi_device *spi)
 #ifdef SPI_CONTROLLER_ENABLE_CS_GPIOD
 	spi->controller->flags |= SPI_CONTROLLER_ENABLE_CS_GPIOD;
 #else
-#warning "SPI_CONTROLLER_ENABLE_CS_GPIOD macro not defined"
+	/*
+	 * SPI_CONTROLLER_ENABLE_CS_GPIOD is a vendor-kernel flag and does not exist in
+	 * mainline (checked against 6.18: spi.h only has HALF_DUPLEX/NO_RX/NO_TX/MUST_RX/
+	 * MUST_TX/GPIO_SS/SUSPENDED/MULTI_CS). Mainline already forces SPI_CS_HIGH for
+	 * cs-gpios targets and lets gpiolib apply the active-low inversion, which is the
