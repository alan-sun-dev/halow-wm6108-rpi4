diff --git a/spi.c b/spi.c
index e5facbd..3db2aaa 100644
--- a/spi.c
+++ b/spi.c
@@ -288,6 +288,9 @@ static void morse_spi_initsequence(struct morse_spi *mspi)
 {
 	struct spi_device *spi = mspi->spi;
 
+	dev_info(&spi->dev, "init: entry mode=0x%x cs_high_default=%d train=%d\n",
+		 spi->mode, !!(spi->mode & SPI_CS_HIGH), 18);
+
 	spi->mode |= SPI_CS_HIGH;
 	if (spi_setup(spi) != 0) {
 		/* Just warn; most cards work without it. */
@@ -295,14 +298,20 @@ static void morse_spi_initsequence(struct morse_spi *mspi)
 		spi->mode &= ~SPI_CS_HIGH;
 	} else {
 		/* We will send only 0xFF for training */
+		dev_info(&spi->dev, "init: CS deasserted for training, mode=0x%x\n",
+			 spi->mode);
 		memset(mspi->data, 0xFF, MM610X_BUF_SIZE);
 		morse_spi_xfer(mspi, 18);
+		print_hex_dump(KERN_INFO, "init: training rx: ", DUMP_PREFIX_NONE,
+			       18, 1, mspi->data, 18, false);
 
 		spi->mode &= ~SPI_CS_HIGH;
 		if (spi_setup(spi) != 0) {
 			/* Wot, we can't get the same setup we had before? */
 			dev_err(&spi->dev, "can't restore chip-select polarity\n");
 		}
+		dev_info(&spi->dev, "init: CS polarity restored, mode=0x%x\n",
+			 spi->mode);
 	}
 }
 
@@ -403,6 +412,10 @@ static int morse_spi_cmd(struct morse_spi *mspi, u8 cmd, u32 arg)
 
 	ret = morse_spi_xfer(mspi, buffer_size);
 
+	if (cmd == SD_IO_MORSE_INIT)
+		print_hex_dump(KERN_INFO, "cmd63 rx: ", DUMP_PREFIX_NONE,
+			       16, 1, mspi->data, 16, false);
+
 	if (ret)
 		return ret;
 
@@ -1516,7 +1529,18 @@ static int morse_spi_probe(struct spi_device *spi)
 #ifdef SPI_CONTROLLER_ENABLE_CS_GPIOD
 	spi->controller->flags |= SPI_CONTROLLER_ENABLE_CS_GPIOD;
 #else
-#warning "SPI_CONTROLLER_ENABLE_CS_GPIOD macro not defined"
+	/*
+	 * SPI_CONTROLLER_ENABLE_CS_GPIOD is a vendor-kernel flag and does not
+	 * exist upstream. Kernels without it already force SPI_CS_HIGH for a
+	 * cs-gpios device and let gpiolib apply the active-low inversion once,
+	 * which is the behaviour the flag was there to obtain, so there is
+	 * nothing to do here.
+	 *
+	 * This was a #warning, and ccflags-y carries -Werror, so it was fatal
+	 * rather than advisory: the driver did not build at all on such a
+	 * kernel -- including raspberrypi/linux 6.6.51, which does not define
+	 * the macro either.
+	 */
 #endif
 #endif
 	morse_spi_xfer_init(mspi);
