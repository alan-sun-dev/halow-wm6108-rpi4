# Real values live in secrets.env, which is gitignored. Copy this file to
# secrets.env and fill it in before running apply-to-card.sh.
#
# WIFI_PSK      the house SSID's WPA passphrase
# PASSWORD_HASH the login password for the 'alan' account, as a crypt(3) hash.
#               Generate on any Linux box:  openssl passwd -6
WIFI_PSK=__WIFI_PSK__
PASSWORD_HASH=__PASSWORD_HASH__
